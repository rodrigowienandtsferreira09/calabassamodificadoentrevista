# Copie para .env e preencha. Nunca commite o .env com valores reais.

# Banco e servidor
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haras_exemplo"
PORT=3333
# Origens do site separadas por vírgula (em produção é obrigatório)
ALLOWED_ORIGINS=http://localhost:3001

# Autenticação — gere valores com: openssl rand -base64 32
JWT_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_DAYS=14

# Criptografia de CPF/CNPJ e telefone (AES-256-GCM) — openssl rand -base64 32
# Perder a chave torna os dados já criptografados irrecuperáveis.
FIELD_ENCRYPTION_KEY=
FIELD_HASH_PEPPER=

# URLs públicas (HTTPS em produção, sem barra no final)
BASE_URL=http://localhost:3333
WEB_APP_URL=http://localhost:3001

# Mercado Pago (Checkout Pro)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_TEST_MODE=true
# MP_MAX_INSTALLMENTS=12

# Cloudflare R2 (upload de imagens)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# E-mail (Resend) — redefinição de senha
RESEND_API_KEY=
EMAIL_FROM=

# Opcionais
# PLATFORM_PHONE=
# SENTRY_DSN=
# SEED_PASSWORD=   senha dos usuários de teste criados pelo seed (se vazio, uma aleatória é gerada)
